{{ form_start(form, {attr: {action: path('admin_menu_modal', {id: menu.id}), class: 'row g-3'}}) }}

{# Champ plats caché — alimenté par JS #}
{{ form_widget(form.plats, {attr: {class: 'd-none', id: 'plats-hidden-select'}}) }}

<div class="col-md-6">
    <label class="form-label fw-semibold" style="color:#800020;">Nom du menu</label>
    {{ form_widget(form.titre, {attr: {class: 'form-control'}}) }}
</div>
<div class="col-md-6">
    <label class="form-label fw-semibold" style="color:#800020;">Prix (€ / pers.)</label>
    {{ form_widget(form.prixParPersonne, {attr: {class: 'form-control'}}) }}
</div>

<div class="col-md-6">
    <label class="form-label fw-semibold" style="color:#800020;">Personnes minimum</label>
    {{ form_widget(form.nombrePersonneMinimum, {attr: {class: 'form-control'}}) }}
</div>
<div class="col-md-6">
    <label class="form-label fw-semibold" style="color:#800020;">Quantité restante</label>
    {{ form_widget(form.quantiteRestante, {attr: {class: 'form-control'}}) }}
</div>

<div class="col-12">
    <label class="form-label fw-semibold" style="color:#800020;">Description</label>
    {{ form_widget(form.description, {attr: {class: 'form-control', rows: 3}}) }}
</div>
<div class="col-12">
    <div class="mb-2 d-flex align-items-center gap-2">
        <i class="bi bi-list-ul" style="color:#800020;"></i>
        <span class="fw-bold" style="color:#800020;font-family:'Aclonica',sans-serif;font-size:1rem;">Composition du menu</span>
    </div>
    <div class="d-flex flex-column gap-2">
        {% set groups = [
            {key: 'entree',  label: 'ENTRÉE',  bg: '#28a745'},
            {key: 'plat',    label: 'PLAT',    bg: '#800020'},
            {key: 'dessert', label: 'DESSERT', bg: '#BE7D8D'},
        ] %}
        {% for group in groups %}
        <div class="d-flex align-items-center gap-3">
            <span style="background:{{ group.bg }};color:#fff;padding:.3rem .7rem;border-radius:6px;font-size:.72rem;font-weight:700;min-width:70px;text-align:center;letter-spacing:.05em;">
                {{ group.label }}
            </span>
            <select class="form-select plat-single-select" data-type="{{ group.key }}" style="flex:1;">
                <option value="">— Aucun —</option>
                {% for plat in platsByType[group.key] %}
                    <option value="{{ plat.id }}" {% if menu.plats.contains(plat) %}selected{% endif %}>
                        {{ plat.titre }}
                    </option>
                {% endfor %}
            </select>
        </div>
        {% endfor %}
    </div>
</div>

<div class="col-md-6">
    <label class="form-label fw-semibold" style="color:#800020;">Thème</label>
    {{ form_widget(form.theme, {attr: {class: 'form-select'}}) }}
</div>
<div class="col-md-6">
    <label class="form-label fw-semibold" style="color:#800020;">Statut</label>
    <div class="d-flex align-items-center gap-2 mt-2">
        {{ form_widget(form.actif) }}
        <span style="font-size:.95rem;">Menu actif</span>
    </div>
</div>

<div class="col-12">
    <label class="form-label fw-semibold" style="color:#800020;">Conditions</label>
    {{ form_widget(form.conditions, {attr: {class: 'form-control', rows: 2}}) }}
</div>

<div class="col-12">
    <div class="p-3 rounded" style="background:#fdf0f3;border:1px solid #E8D1D7;">
        <label class="form-label fw-semibold mb-2" style="color:#800020;">Régimes alimentaires</label>
        <div class="d-flex flex-column gap-1">
        {% for regime in form.regimes %}
            <div class="d-flex align-items-center gap-2">
                {{ form_widget(regime) }}
                <label style="color:#800020;font-size:.88rem;cursor:pointer;margin:0;">{{ form_label(regime)|raw }}</label>
            </div>
        {% endfor %}
        </div>
    </div>
</div>

<div class="col-12 d-flex gap-3 justify-content-end pt-3 border-top mt-1">
    <button type="button"
            onclick="document.getElementById('menu-modal').style.display='none'"
            style="border:2px solid #BE7D8D;color:#BE7D8D;background:transparent;border-radius:999px;padding:.55rem 2rem;font-weight:500;cursor:pointer;">
        Annuler
    </button>
    <button type="submit"
            style="border:none;background:#BE7D8D;color:#fff;border-radius:999px;padding:.55rem 2rem;font-weight:500;cursor:pointer;">
        <i class="bi bi-floppy-fill me-1"></i> Enregistrer
    </button>
</div>

{{ form_end(form) }}

<script>
(function () {
    const hiddenSelect = document.getElementById('plats-hidden-select');
    const form = hiddenSelect ? hiddenSelect.closest('form') : null;
    if (!form) return;
    form.addEventListener('submit', () => {
        Array.from(hiddenSelect.options).forEach(o => o.selected = false);
        document.querySelectorAll('.plat-single-select').forEach(sel => {
            if (!sel.value) return;
            const opt = hiddenSelect.querySelector('option[value="' + sel.value + '"]');
            if (opt) opt.selected = true;
        });
    });
})();
</script>
