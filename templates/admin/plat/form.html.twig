{% extends 'admin/layout.html.twig' %}
{% block title %}{{ titre }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>{{ titre }}</h2>
    <a href="{{ path('admin_plat_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        {{ form_start(form, {attr: {class: 'row g-3'}}) }}
            <div class="col-md-8">
                {{ form_row(form.titre) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.typePlat) }}
            </div>
            <div class="col-12">
                {{ form_row(form.imageChemin) }}
            </div>
            <div class="col-12">
                <div class="card p-3">
                    <h6>Allergènes</h6>
                    <div class="row">
                    {% for allergene in form.allergenes %}
                        <div class="col-md-3 col-6">{{ form_widget(allergene) }} {{ form_label(allergene) }}</div>
                    {% endfor %}
                    </div>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Enregistrer
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
