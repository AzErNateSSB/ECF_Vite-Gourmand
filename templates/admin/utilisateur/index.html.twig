{% extends 'admin/layout.html.twig' %}
{% block title %}Utilisateurs{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Utilisateurs</h2>
    <button type="button"
            onclick="document.getElementById('modal-creer-employe').style.display='flex'"
            class="btn btn-sm"
            style="background:#800020;color:#fff;border-radius:8px;">
        <i class="bi bi-person-plus-fill me-1"></i> Créer un employé
    </button>
</div>

<div class="table-responsive">
    <table class="table table-hover bg-white rounded shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Commandes</th>
                <th>Actif</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for u in utilisateurs %}
            <tr class="{{ u.actif ? '' : 'table-secondary text-muted' }}">
                <td>{{ u.id }}</td>
                <td>{{ u.prenom }} {{ u.nom }}</td>
                <td>{{ u.email }}</td>
                <td>
                    <span class="badge
                        {% if u.role and u.role.libelle == 'administrateur' %}bg-danger
                        {% elseif u.role and u.role.libelle == 'employe' %}bg-warning text-dark
                        {% else %}bg-secondary{% endif %}">
                        {{ u.role ? u.role.libelle : 'utilisateur' }}
                    </span>
                </td>
                <td>{{ u.commandes|length }}</td>
                <td>
                    {% if u.actif %}
                        <span class="badge bg-success">Actif</span>
                    {% else %}
                        <span class="badge bg-secondary">Inactif</span>
                    {% endif %}
                </td>
                <td>
                    <form method="post" action="{{ path('admin_utilisateur_toggle', {id: u.id}) }}" class="d-inline">
                        <button type="submit" class="btn btn-sm {{ u.actif ? 'btn-outline-warning' : 'btn-outline-success' }}">
                            {% if u.actif %}
                                <i class="bi bi-person-dash"></i> Désactiver
                            {% else %}
                                <i class="bi bi-person-check"></i> Activer
                            {% endif %}
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7" class="text-center text-muted">Aucun utilisateur.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# ── MODAL Créer un employé ───────────────────────────────────────────────── #}
<div id="modal-creer-employe"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1050;align-items:center;justify-content:center;"
     onclick="if(event.target===this)this.style.display='none'">
    <div style="background:#fff;border-radius:16px;width:min(520px,95vw);padding:2rem;box-shadow:0 20px 60px rgba(0,0,0,.3);">

        <div class="d-flex justify-content-between align-items-center pb-3 mb-4" style="border-bottom:2px solid #E8D1D7;">
            <h5 class="mb-0" style="color:#800020;font-family:'Aclonica',sans-serif;font-size:1.2rem;">
                <i class="bi bi-person-plus-fill me-2"></i>Créer un compte employé
            </h5>
            <button type="button" onclick="document.getElementById('modal-creer-employe').style.display='none'"
                    style="background:none;border:none;font-size:1.4rem;color:#999;cursor:pointer;">✕</button>
        </div>

        <form method="post" action="{{ path('admin_utilisateur_creer_employe') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('creer_employe') }}">

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" style="color:#800020;">Prénom</label>
                    <input type="text" name="prenom" required class="form-control" style="border-color:#E8D1D7;">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" style="color:#800020;">Nom</label>
                    <input type="text" name="nom" required class="form-control" style="border-color:#E8D1D7;">
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold" style="color:#800020;">Adresse e-mail</label>
                    <input type="email" name="email" required class="form-control" style="border-color:#E8D1D7;">
                    <div class="form-text">Les identifiants de connexion seront envoyés à cette adresse.</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold" style="color:#800020;">Téléphone <span class="text-muted fw-normal">(optionnel)</span></label>
                    <input type="tel" name="telephone" class="form-control" style="border-color:#E8D1D7;">
                </div>
            </div>

            <div class="p-3 mt-3 rounded" style="background:#fdf0f3;border:1px solid #E8D1D7;font-size:.85rem;color:#800020;">
                <i class="bi bi-info-circle-fill me-1"></i>
                Un mot de passe temporaire sera généré automatiquement et envoyé par e-mail à l'employé.
            </div>

            <div class="d-flex gap-3 justify-content-end mt-4 pt-3" style="border-top:1px solid #E8D1D7;">
                <button type="button" onclick="document.getElementById('modal-creer-employe').style.display='none'"
                        style="border:2px solid #BE7D8D;color:#BE7D8D;background:transparent;border-radius:999px;padding:.5rem 1.5rem;cursor:pointer;font-weight:500;">
                    Annuler
                </button>
                <button type="submit"
                        style="border:none;background:#800020;color:#fff;border-radius:999px;padding:.5rem 1.5rem;cursor:pointer;font-weight:500;">
                    <i class="bi bi-person-plus-fill me-1"></i> Créer le compte
                </button>
            </div>
        </form>

    </div>
</div>
{% endblock %}
