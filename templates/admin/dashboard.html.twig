{% extends 'admin/layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block content %}
<h2 class="mb-4">Tableau de bord</h2>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">{{ nb_menus }}</div>
                    <div>Menus</div>
                </div>
                <i class="bi bi-journal-richtext fs-1 opacity-50"></i>
            </div>
            <div class="card-footer">
                <a href="{{ path('admin_menu_index') }}" class="text-white text-decoration-none small">Voir les menus →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">{{ nb_plats }}</div>
                    <div>Plats</div>
                </div>
                <i class="bi bi-egg-fried fs-1 opacity-50"></i>
            </div>
            <div class="card-footer">
                <a href="{{ path('admin_plat_index') }}" class="text-white text-decoration-none small">Voir les plats →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">{{ nb_commandes }}</div>
                    <div>Commandes</div>
                </div>
                <i class="bi bi-bag-check fs-1 opacity-50"></i>
            </div>
            <div class="card-footer">
                <a href="{{ path('admin_commande_index') }}" class="text-white text-decoration-none small">Voir les commandes →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">{{ nb_utilisateurs }}</div>
                    <div>Utilisateurs</div>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
            <div class="card-footer">
                <a href="{{ path('admin_utilisateur_index') }}" class="text-white text-decoration-none small">Voir les utilisateurs →</a>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-3">5 dernières commandes</h5>
{% if commandes_recentes is empty %}
    <p class="text-muted">Aucune commande pour l'instant.</p>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover bg-white rounded shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for commande in commandes_recentes %}
                <tr>
                    <td>{{ commande.id }}</td>
                    <td>{{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}</td>
                    <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                    <td>{{ commande.prixTotal|number_format(2, ',', ' ') }} €</td>
                    <td>
                        <span class="badge
                            {% if commande.statut == 'en_attente' %}bg-warning text-dark
                            {% elseif commande.statut == 'confirmee' %}bg-info
                            {% elseif commande.statut == 'en_preparation' %}bg-primary
                            {% elseif commande.statut == 'prete' %}bg-success
                            {% elseif commande.statut == 'livree' %}bg-secondary
                            {% else %}bg-danger{% endif %}">
                            {{ commande.statut|replace({'_': ' '}) }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('admin_commande_show', {id: commande.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
