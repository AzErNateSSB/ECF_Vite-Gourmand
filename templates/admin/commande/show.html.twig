{% extends 'admin/layout.html.twig' %}
{% block title %}Commande #{{ commande.id }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Commande #{{ commande.id }}</h2>
    <a href="{{ path('admin_commande_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header"><strong>Informations</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Client</dt>
                    <dd class="col-7">{{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}</dd>
                    <dt class="col-5">Email</dt>
                    <dd class="col-7">{{ commande.utilisateur.email }}</dd>
                    <dt class="col-5">Menu</dt>
                    <dd class="col-7">{{ commande.menu ? commande.menu.titre : '—' }}</dd>
                    <dt class="col-5">Date</dt>
                    <dd class="col-7">{{ commande.dateCommande|date('d/m/Y H:i') }}</dd>
                    <dt class="col-5">Personnes</dt>
                    <dd class="col-7">{{ commande.nombrePersonne }}</dd>
                    <dt class="col-5">Total</dt>
                    <dd class="col-7"><strong>{{ commande.prixTotal|number_format(2, ',', ' ') }} €</strong></dd>
                    <dt class="col-5">Statut actuel</dt>
                    <dd class="col-7">
                        <span class="badge
                            {% if commande.statut == 'en_attente' %}bg-warning text-dark
                            {% elseif commande.statut == 'confirmee' %}bg-info
                            {% elseif commande.statut == 'en_preparation' %}bg-primary
                            {% elseif commande.statut == 'prete' %}bg-success
                            {% elseif commande.statut == 'livree' %}bg-secondary
                            {% else %}bg-danger{% endif %}">
                            {{ commande.statut|replace({'_': ' '}) }}
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header"><strong>Changer le statut</strong></div>
            <div class="card-body">
                <form method="post" action="{{ path('admin_commande_statut', {id: commande.id}) }}">
                    <select name="statut" class="form-select mb-3">
                        {% for statut in ['en_attente', 'confirmee', 'en_preparation', 'prete', 'livree', 'annulee'] %}
                            <option value="{{ statut }}" {% if commande.statut == statut %}selected{% endif %}>
                                {{ statut|replace({'_': ' '})|capitalize }}
                            </option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-primary w-100">Mettre à jour</button>
                </form>
            </div>
        </div>
    </div>

    {% if commande.suiviCommandes is not empty %}
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header"><strong>Historique</strong></div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Date</th><th>Statut</th><th>Note</th></tr></thead>
                    <tbody>
                    {% for suivi in commande.suiviCommandes %}
                        <tr>
                            <td>{{ suivi.dateStatut|date('d/m/Y H:i') }}</td>
                            <td>{{ suivi.statut|replace({'_': ' '}) }}</td>
                            <td>{{ suivi.note ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
