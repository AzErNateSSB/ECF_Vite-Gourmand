{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

{% include '_navbar.html.twig' %}

<main id="veg-main">

{# ── HERO 1 : Présentation ────────────────────────────────────────────────── #}
<article class="hero" style="background-image:url('{{ asset('img/Plats.png') }}');">
    <div class="hero-overlay"></div>
    <div class="container h-100">
        <div class="row h-100 align-items-center">
            <div class="col-12 col-lg-6 hero-content">
                <p class="hero-label">VITE &amp; GOURMAND</p>
                <h1 class="hero-title">
                    L'art de recevoir,<br>
                    le <span class="hero-accent">goût</span> en plus.
                </h1>
                <p class="hero-desc">
                    Des créations culinaires de saison<br>
                    pour sublimer vos événements<br>
                    et marquer les esprits.
                </p>
                <a href="{{ path('app_menus') }}" class="btn hero-btn">Découvrir nos menus</a>
                <p class="hero-mention mt-3 mb-0">
                    <i class="bi bi-check-circle"></i> Produits frais &amp; de saison
                </p>
            </div>
        </div>
    </div>
</article>

<div class="hero-separator">
    <span></span><i class="bi bi-flower1"></i><span></span>
</div>

{# ── HERO 2 : L'équipe ────────────────────────────────────────────────────── #}
<article class="hero hero--right" style="background-image:url('{{ asset('img/Equipe.png') }}');background-position:center 20%;">
    <div class="hero-overlay hero-overlay--right"></div>
    <div class="container h-100">
        <div class="row h-100 align-items-center justify-content-end">
            <div class="col-12 col-lg-6 hero-content">
                <p class="hero-label">NOTRE ÉQUIPE</p>
                <h2 class="hero-title">
                    Une équipe passionnée,<br>
                    à votre <span class="hero-accent">service</span>.
                </h2>
                <p class="hero-desc">
                    Derrière chaque assiette, une brigade de cuisiniers engagés,
                    sélectionnant les meilleurs produits locaux pour composer
                    des créations qui vous ressemblent. De la préparation au
                    service, nous mettons tout notre savoir-faire au cœur de vos
                    événements pour en faire des moments inoubliables.
                </p>
                <p class="hero-mention">
                    <i class="bi bi-people-fill"></i> Une équipe à taille humaine, toujours à l'écoute
                </p>
            </div>
        </div>
    </div>
</article>

<div class="hero-separator">
    <span></span><i class="bi bi-flower1"></i><span></span>
</div>

{# ── AVIS ─────────────────────────────────────────────────────────────────── #}
<article class="avis-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="avis-section__title">Ils nous ont fait confiance</h2>
        </div>

        <div class="avis-carousel-wrapper">
            <div id="carouselAvis" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
                <div class="carousel-inner">
                    {% if avisPublies is defined and avisPublies|length > 0 %}
                        {% for i, av in avisPublies %}
                        <div class="carousel-item {{ i == 0 ? 'active' : '' }}">
                            <div class="avis-card mx-auto">
                                <div class="avis-card__stars">
                                    {% for s in 1..av.note %}★{% endfor %}{% for s in av.note+1..5 %}☆{% endfor %}
                                </div>
                                <p class="avis-card__quote">« {{ av.description }} »</p>
                                <div class="avis-card__author">
                                    <strong>{{ av.commande.utilisateur.prenom }} {{ av.commande.utilisateur.nom|slice(0,1) }}.</strong>
                                    <span>{{ av.createdAt|date('F Y') }}</span>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    {% else %}
                        {# Avis d'exemple tant qu'aucun avis n'est publié #}
                        {% set avis_list = [
                            { stars: '★★★★★', quote: '« Service impeccable du début à la fin. Les plats étaient raffinés, parfaitement présentés et délicieux. Nos invités ont encore les étoiles dans les yeux ! »', author: 'Sophie M.', event: 'Mariage — 120 convives' },
                            { stars: '★★★★★', quote: '« Une prestation haut de gamme pour notre séminaire d\'entreprise. L\'équipe a su s\'adapter à nos contraintes et proposer un buffet inventif et généreux. »', author: 'Thomas R.', event: 'Séminaire — 80 personnes' },
                            { stars: '★★★★★', quote: '« Rien à redire — de la prise de contact jusqu\'au service, tout était parfait. La cuisine est généreuse, de saison, et pleine de caractère. »', author: 'Claire B.', event: 'Anniversaire — 60 convives' },
                        ] %}
                        {% for i, t in avis_list %}
                        <div class="carousel-item {{ i == 0 ? 'active' : '' }}">
                            <div class="avis-card mx-auto">
                                <div class="avis-card__stars">{{ t.stars }}</div>
                                <p class="avis-card__quote">{{ t.quote }}</p>
                                <div class="avis-card__author">
                                    <strong>{{ t.author }}</strong>
                                    <span>{{ t.event }}</span>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    {% endif %}
                </div>

                <div class="avis-section__controls">
                    <button class="avis-btn" type="button" data-bs-target="#carouselAvis" data-bs-slide="prev">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <div class="carousel-indicators avis-indicators">
                        {% set nb = (avisPublies is defined and avisPublies|length > 0) ? avisPublies|length : 3 %}
                        {% for i in 0..nb-1 %}
                        <button type="button" data-bs-target="#carouselAvis"
                                data-bs-slide-to="{{ i }}"
                                class="{{ i == 0 ? 'active' : '' }}"></button>
                        {% endfor %}
                    </div>
                    <button class="avis-btn" type="button" data-bs-target="#carouselAvis" data-bs-slide="next">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="{{ path('app_menus') }}" class="avis-cta">Et pourquoi pas vous ?</a>
        </div>
    </div>
</article>

</main>

{% include '_footer.html.twig' %}

{% endblock %}
