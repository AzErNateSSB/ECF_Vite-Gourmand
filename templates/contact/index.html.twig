{% extends 'base.html.twig' %}

{% block title %}Contact — Vite & Gourmand{% endblock %}

{% block body %}
{% include '_navbar.html.twig' %}

<main id="veg-main">
<section class="contact-page">
    <div class="container py-5">
        <div class="auth-card auth-card--wide" style="max-width:680px;">

            <h1 class="auth-card__title">Nous contacter</h1>
            <p class="contact-page__intro">
                Une question, une demande de devis ou simplement envie d'en savoir plus ?<br>
                Remplissez le formulaire ci-dessous, nous vous répondrons dans les plus brefs délais.
            </p>

            <div class="auth-alert auth-alert--error" id="contact-error" style="display:none;"></div>

            <div id="contact-form">
                <div class="auth-field">
                    <label class="auth-field__label" for="contact-sujet">Sujet</label>
                    <input class="auth-field__input" type="text" id="contact-sujet"
                           placeholder="Ex : Demande de devis, Question sur un menu…" maxlength="100">
                    <span class="auth-field__error" id="err-contact-sujet"></span>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="contact-email">Votre e-mail</label>
                    <input class="auth-field__input" type="email" id="contact-email"
                           value="{{ app.user ? app.user.email : '' }}"
                           placeholder="vous@exemple.com">
                    <span class="auth-field__error" id="err-contact-email"></span>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="contact-message">Message</label>
                    <textarea class="auth-field__input contact-textarea" id="contact-message"
                              placeholder="Décrivez votre demande…" rows="6" maxlength="2000"></textarea>
                    <span class="contact-char-count" id="contact-char-count">0 / 2000</span>
                    <span class="auth-field__error" id="err-contact-message"></span>
                </div>

                <button class="auth-btn" id="contact-submit">
                    <i class="bi bi-send-fill"></i> Envoyer le message
                </button>
            </div>

            <div id="contact-success" style="display:none;" class="contact-success">
                <div class="contact-success__icon"><i class="bi bi-envelope-check-fill"></i></div>
                <h2 class="contact-success__title">Message envoyé !</h2>
                <p class="contact-success__text">
                    Merci pour votre message. L'équipe Vite &amp; Gourmand vous répondra à
                    <strong id="contact-success-email"></strong> dans les meilleurs délais.
                </p>
                <button class="auth-btn" id="contact-new" style="max-width:260px;margin:0 auto;">
                    <i class="bi bi-arrow-counterclockwise"></i> Envoyer un autre message
                </button>
            </div>

        </div>

        <div class="contact-info">
            <div class="contact-info__item">
                <i class="bi bi-telephone-fill"></i>
                <div><strong>Téléphone</strong><span>05 56 00 00 00</span></div>
            </div>
            <div class="contact-info__item">
                <i class="bi bi-envelope-fill"></i>
                <div><strong>E-mail</strong><span>contact@viteetgourmand.fr</span></div>
            </div>
            <div class="contact-info__item">
                <i class="bi bi-geo-alt-fill"></i>
                <div><strong>Adresse</strong><span>Bordeaux, France</span></div>
            </div>
            <div class="contact-info__item">
                <i class="bi bi-clock-fill"></i>
                <div><strong>Horaires</strong><span>Lun–Ven 09h–18h · Sam 10h–16h</span></div>
            </div>
        </div>
    </div>
</section>
</main>

{% include '_footer.html.twig' %}

<script>
const msgArea = document.getElementById('contact-message');
const charCount = document.getElementById('contact-char-count');
if (msgArea) {
    msgArea.addEventListener('input', () => {
        charCount.textContent = msgArea.value.length + ' / 2000';
    });
}
document.getElementById('contact-submit').addEventListener('click', function() {
    const email = document.getElementById('contact-email').value.trim();
    const msg = document.getElementById('contact-message').value.trim();
    let ok = true;
    document.getElementById('err-contact-email').textContent = '';
    document.getElementById('err-contact-message').textContent = '';
    if (!email || !email.includes('@')) {
        document.getElementById('err-contact-email').textContent = 'E-mail invalide.';
        ok = false;
    }
    if (!msg) {
        document.getElementById('err-contact-message').textContent = 'Le message est requis.';
        ok = false;
    }
    if (ok) {
        document.getElementById('contact-success-email').textContent = email;
        document.getElementById('contact-form').style.display = 'none';
        document.getElementById('contact-success').style.display = 'flex';
    }
});
document.getElementById('contact-new').addEventListener('click', function() {
    document.getElementById('contact-message').value = '';
    document.getElementById('contact-char-count').textContent = '0 / 2000';
    document.getElementById('contact-form').style.display = 'block';
    document.getElementById('contact-success').style.display = 'none';
});
</script>
{% endblock %}
