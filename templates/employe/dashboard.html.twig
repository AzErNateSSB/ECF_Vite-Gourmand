{% extends 'employe/layout.html.twig' %}
{% block title %}Espace Employé{% endblock %}

{% block employe_content %}

{# ── En-tête ─────────────────────────────────────────────────────────────── #}
<div class="account-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
        <div class="account-avatar">
            <i class="bi bi-person-badge-fill" style="font-size:1.5rem;"></i>
        </div>
        <div>
            <h1 class="account-name mb-0">Espace Employé</h1>
        </div>
    </div>
    <span class="badge" style="background:#800020;font-size:.95rem;padding:.5rem 1rem;font-family:'Aclonica',sans-serif;">
        {{ app.user.prenom }} {{ app.user.nom }} – {{ app.user.roles|join(', ')|replace({'ROLE_ADMINISTRATEUR':'Administrateur','ROLE_EMPLOYE':'Employé','ROLE_UTILISATEUR':''}) }}
    </span>
</div>

{# ── Onglets ─────────────────────────────────────────────────────────────── #}
<div class="account-tabs d-flex gap-2 mb-4 flex-wrap justify-content-center">
    <button class="account-tab-btn active" data-tab="commandes">
        <i class="bi bi-bag-check-fill me-1"></i> Commandes
        <span class="badge rounded-pill ms-1" style="background:#BE7D8D;">{{ commandes|length }}</span>
    </button>
    <button class="account-tab-btn" data-tab="plats">
        <i class="bi bi-egg-fried me-1"></i> Plats
    </button>
    <button class="account-tab-btn" data-tab="menus">
        <i class="bi bi-journal-richtext me-1"></i> Menus
    </button>
    <button class="account-tab-btn" data-tab="avis">
        <i class="bi bi-star-fill me-1"></i> Avis
        <span class="badge rounded-pill ms-1" style="background:#BE7D8D;">{{ avis|length }}</span>
    </button>
</div>

{# ── TAB : Commandes ──────────────────────────────────────────────────────── #}
<div id="tab-commandes" class="tab-panel">

    {# Barre de filtres #}
    <div class="d-flex gap-2 mb-4 justify-content-center flex-wrap align-items-center">
        <select id="filter-statut" class="form-select" style="max-width:220px;">
            <option value="">Tous les statuts</option>
            <option value="en_attente">En attente</option>
            <option value="confirmee">Confirmée</option>
            <option value="en_preparation">En préparation</option>
            <option value="prete">Prête</option>
            <option value="en_cours_de_livraison">En cours de livraison</option>
            <option value="livree">Livrée</option>
            <option value="en_attente_retour_materiel">Attente retour matériel</option>
            <option value="terminee">Terminée</option>
            <option value="annulee">Annulée</option>
        </select>
        <input type="text" id="filter-search" class="form-control" placeholder="Rechercher par nom, e-mail ou ID…" style="max-width:500px;">
    </div>

    <div class="table-responsive account-card p-0" style="border-radius:12px;overflow:hidden;max-width:100%;">
        <table class="table table-hover mb-0" id="commandes-table">
            <thead style="background:#800020;color:#fff;">
                <tr>
                    <th class="px-4 py-3">ID</th>
                    <th class="px-3 py-3">Client</th>
                    <th class="px-3 py-3">Menu</th>
                    <th class="px-3 py-3">Date prestation</th>
                    <th class="px-3 py-3">Total</th>
                    <th class="px-3 py-3">Statut</th>
                    <th class="px-3 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for commande in commandes %}
                <tr data-statut="{{ commande.statut }}"
                    data-search="{{ commande.utilisateur.prenom|lower }} {{ commande.utilisateur.nom|lower }} {{ commande.utilisateur.email|lower }} {{ commande.numeroCommande|lower }}">
                    <td class="px-4 py-3">
                        <span style="font-size:.82rem;color:#800020;font-weight:600;">{{ commande.numeroCommande }}</span>
                    </td>
                    <td class="px-3 py-3">
                        <strong>{{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}</strong><br>
                        <small class="text-muted">{{ commande.utilisateur.email }}</small>
                    </td>
                    <td class="px-3 py-3">
                        {{ commande.menu ? commande.menu.titre : '—' }}<br>
                        <small class="text-muted">{{ commande.nombrePersonne }} pers.</small>
                    </td>
                    <td class="px-3 py-3">
                        {{ commande.datePrestation ? commande.datePrestation|date('d/m/Y') : (commande.dateCommande|date('d/m/Y')) }}<br>
                        <small class="text-muted">{{ commande.dateCommande|date('H:i') }}</small>
                    </td>
                    <td class="px-3 py-3">
                        <strong>{{ commande.prixTotal|number_format(2, ',', ' ') }} €</strong>
                    </td>
                    <td class="px-3 py-3">
                        <form method="post" action="{{ path('employe_commande_statut', {id: commande.id}) }}">
                            <select name="statut" class="form-select form-select-sm statut-select"
                                onchange="this.form.submit()"
                                style="min-width:175px;border-color:
                                    {% if commande.statut == 'en_attente' %}#ffc107
                                    {% elseif commande.statut == 'confirmee' %}#0dcaf0
                                    {% elseif commande.statut == 'en_preparation' %}#0d6efd
                                    {% elseif commande.statut == 'prete' %}#198754
                                    {% elseif commande.statut == 'en_cours_de_livraison' %}#fd7e14
                                    {% elseif commande.statut == 'livree' %}#6f42c1
                                    {% elseif commande.statut == 'en_attente_retour_materiel' %}#e83e8c
                                    {% elseif commande.statut == 'terminee' %}#6c757d
                                    {% else %}#dc3545{% endif %};
                                    color:
                                    {% if commande.statut == 'en_attente' %}#856404
                                    {% elseif commande.statut == 'confirmee' %}#055160
                                    {% elseif commande.statut == 'en_preparation' %}#0d6efd
                                    {% elseif commande.statut == 'prete' %}#198754
                                    {% elseif commande.statut == 'en_cours_de_livraison' %}#fd7e14
                                    {% elseif commande.statut == 'livree' %}#6f42c1
                                    {% elseif commande.statut == 'en_attente_retour_materiel' %}#e83e8c
                                    {% elseif commande.statut == 'terminee' %}#6c757d
                                    {% else %}#dc3545{% endif %};">
                                {% if commande.statut == 'annulee' %}
                                    <option value="annulee" selected>Annulée</option>
                                {% else %}
                                    <option value="en_attente"               {% if commande.statut == 'en_attente' %}selected{% endif %}>En attente</option>
                                    <option value="confirmee"                {% if commande.statut == 'confirmee' %}selected{% endif %}>Confirmée</option>
                                    <option value="en_preparation"           {% if commande.statut == 'en_preparation' %}selected{% endif %}>En préparation</option>
                                    <option value="prete"                    {% if commande.statut == 'prete' %}selected{% endif %}>Prête</option>
                                    <option value="en_cours_de_livraison"    {% if commande.statut == 'en_cours_de_livraison' %}selected{% endif %}>En cours de livraison</option>
                                    <option value="livree"                   {% if commande.statut == 'livree' %}selected{% endif %}>Livrée</option>
                                    <option value="en_attente_retour_materiel" {% if commande.statut == 'en_attente_retour_materiel' %}selected{% endif %}>Attente retour matériel</option>
                                    <option value="terminee"                 {% if commande.statut == 'terminee' %}selected{% endif %}>Terminée</option>
                                {% endif %}
                            </select>
                        </form>
                    </td>
                    <td class="px-3 py-3" style="white-space:nowrap;">
                        <a href="{{ path('employe_commande_show', {id: commande.id}) }}"
                           class="btn btn-sm me-1"
                           style="background:transparent;border:1px solid #BE7D8D;color:#800020;border-radius:8px;">
                            <i class="bi bi-eye"></i>
                        </a>
                        {% if commande.statut != 'annulee' and commande.statut != 'terminee' %}
                        <button type="button"
                                onclick="ouvrirModalAnnulationEmploye({{ commande.id }}, '{{ commande.numeroCommande }}', '{{ commande.utilisateur.telephone|default('') }}', '{{ csrf_token('employe_annuler_' ~ commande.id) }}')"
                                class="btn btn-sm"
                                style="background:transparent;border:1px solid #dc3545;color:#dc3545;border-radius:8px;"
                                title="Annuler la commande">
                            <i class="bi bi-x-circle"></i>
                        </button>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Aucune commande.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── TAB : Plats ──────────────────────────────────────────────────────────── #}
<div id="tab-plats" class="tab-panel" style="display:none;">
    <div class="mb-3">
        <a href="{{ path('admin_plat_new') }}" class="btn" style="background:#800020;color:#fff;border-radius:8px;">
            <i class="bi bi-plus-lg me-1"></i> Ajouter un plat
        </a>
    </div>
    <div class="row g-3">
    {% for plat in plats %}
        <div class="col-6 col-md-4 col-lg-3">
            <div class="account-card h-100 d-flex flex-column" style="border-radius:12px;overflow:hidden;padding:0;">
                {% if plat.imageChemin %}
                    <img src="{{ asset(plat.imageChemin) }}" alt="{{ plat.titre }}"
                         style="width:100%;height:180px;object-fit:cover;">
                {% else %}
                    <div style="width:100%;height:180px;background:#E8D1D7;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-egg-fried" style="font-size:3rem;color:#BE7D8D;"></i>
                    </div>
                {% endif %}
                <div class="p-3 d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <strong style="font-size:.9rem;color:#540015;line-height:1.2;overflow:hidden;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;">{{ plat.titre }}</strong>
                        <span class="badge ms-2 flex-shrink-0" style="
                            {% if plat.typePlat == 'entree' %}background:#28a745;
                            {% elseif plat.typePlat == 'plat' %}background:#800020;
                            {% else %}background:#BE7D8D;{% endif %}
                            color:#fff;font-size:.7rem;white-space:nowrap;">
                            {{ plat.typePlat|capitalize }}
                        </span>
                    </div>
                    <div class="mb-3 flex-grow-1" style="display:flex;flex-wrap:wrap;gap:4px;align-content:flex-start;">
                        {% for a in plat.allergenes %}
                            <span style="background:#fff3cd;color:#856404;border:1px solid #ffc107;font-size:.7rem;padding:.2rem .45rem;border-radius:.25rem;white-space:nowrap;display:inline-block;">{{ a.libelle }}</span>
                        {% endfor %}
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-sm flex-fill plat-modifier-btn"
                                data-url="{{ path('admin_plat_modal', {id: plat.id}) }}"
                                style="background:#800020;color:#fff;border-radius:6px;">
                            <i class="bi bi-pencil-fill me-1"></i> Modifier
                        </button>
                        <form method="post" action="{{ path('admin_plat_delete', {id: plat.id}) }}"
                              onsubmit="return confirm('Supprimer ce plat ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_plat_' ~ plat.id) }}">
                            <button type="submit" class="btn btn-sm" style="background:#540015;color:#fff;border-radius:6px;">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center text-muted py-4">Aucun plat.</div>
    {% endfor %}
    </div>
</div>

{# ── TAB : Menus ──────────────────────────────────────────────────────────── #}
<div id="tab-menus" class="tab-panel" style="display:none;">
    <div class="mb-3">
        <a href="{{ path('admin_menu_new') }}" class="btn" style="background:#800020;color:#fff;border-radius:8px;">
            <i class="bi bi-plus-lg me-1"></i> Ajouter un menu
        </a>
    </div>
    <div class="row g-3">
    {% for menu in menus %}
        <div class="col-12 col-md-6 col-lg-4">
            <div class="account-card h-100 d-flex flex-column" style="border-radius:12px;overflow:hidden;padding:0;">
                {% set img = menu.menuImages|first %}
                {% if img %}
                    <img src="{{ asset(img.chemin) }}" alt="{{ menu.titre }}"
                         style="width:100%;height:180px;object-fit:cover;">
                {% else %}
                    <div style="width:100%;height:180px;background:#E8D1D7;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-journal-richtext" style="font-size:3rem;color:#BE7D8D;"></i>
                    </div>
                {% endif %}
                <div class="p-3 d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <strong style="color:#540015;">{{ menu.titre }}</strong>
                        {% if menu.actif %}
                            <span class="badge" style="background:#198754;color:#fff;font-size:.7rem;">Actif</span>
                        {% else %}
                            <span class="badge bg-secondary" style="font-size:.7rem;">Inactif</span>
                        {% endif %}
                    </div>
                    <p class="small text-muted mb-2" style="flex-grow:1;">
                        {{ menu.prixParPersonne|number_format(2, ',', ' ') }} € / pers. &nbsp;·&nbsp;
                        {{ menu.nombrePersonneMinimum }} pers. min.
                    </p>
                    <div class="d-flex gap-1 flex-wrap mb-3">
                        {% for regime in menu.regimes %}
                            <span class="badge" style="background:#E8D1D7;color:#800020;font-size:.7rem;">{{ regime.libelle }}</span>
                        {% endfor %}
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-sm flex-fill menu-modifier-btn"
                                data-url="{{ path('admin_menu_modal', {id: menu.id}) }}"
                                style="background:#800020;color:#fff;border-radius:6px;">
                            <i class="bi bi-pencil-fill me-1"></i> Modifier
                        </button>
                        <form method="post" action="{{ path('admin_menu_delete', {id: menu.id}) }}"
                              onsubmit="return confirm('Supprimer ce menu ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_menu_' ~ menu.id) }}">
                            <button type="submit" class="btn btn-sm" style="background:#540015;color:#fff;border-radius:6px;">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center text-muted py-4">Aucun menu.</div>
    {% endfor %}
    </div>
</div>

{# ── TAB : Avis ──────────────────────────────────────────────────────────── #}
<div id="tab-avis" class="tab-panel" style="display:none;">
    <div class="table-responsive account-card p-0" style="border-radius:12px;overflow:hidden;">
        <table class="table table-hover mb-0">
            <thead style="background:#800020;color:#fff;">
                <tr>
                    <th class="px-4 py-3">Client</th>
                    <th class="px-3 py-3">Commande</th>
                    <th class="px-3 py-3">Note</th>
                    <th class="px-3 py-3">Commentaire</th>
                    <th class="px-3 py-3">Date</th>
                    <th class="px-3 py-3">Statut</th>
                    <th class="px-3 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for av in avis %}
                <tr>
                    <td class="px-4 py-3">
                        <strong>{{ av.commande.utilisateur.prenom }} {{ av.commande.utilisateur.nom }}</strong>
                    </td>
                    <td class="px-3 py-3 small text-muted">{{ av.commande.numeroCommande }}</td>
                    <td class="px-3 py-3" style="color:#BE7D8D;font-size:1.1rem;letter-spacing:1px;">
                        {% for i in 1..av.note %}★{% endfor %}{% for i in av.note+1..5 %}☆{% endfor %}
                    </td>
                    <td class="px-3 py-3" style="max-width:260px;">
                        <span style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{{ av.description }}</span>
                    </td>
                    <td class="px-3 py-3 small text-muted">{{ av.createdAt|date('d/m/Y') }}</td>
                    <td class="px-3 py-3">
                        {% if av.statut == 'publie' %}
                            <span style="background:#d1e7dd;color:#0a3622;padding:.2rem .65rem;border-radius:999px;font-size:.75rem;font-weight:600;">Publié</span>
                        {% elseif av.statut == 'refuse' %}
                            <span style="background:#f8d7da;color:#842029;padding:.2rem .65rem;border-radius:999px;font-size:.75rem;font-weight:600;">Refusé</span>
                        {% else %}
                            <span style="background:#fff3cd;color:#856404;padding:.2rem .65rem;border-radius:999px;font-size:.75rem;font-weight:600;">En attente</span>
                        {% endif %}
                    </td>
                    <td class="px-3 py-3" style="white-space:nowrap;">
                        {% if av.statut != 'publie' %}
                        <form method="post" action="{{ path('employe_avis_valider', {id: av.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('avis_action_' ~ av.id) }}">
                            <button type="submit" title="Valider"
                                    style="background:#198754;border:none;color:#fff;border-radius:8px;padding:.3rem .65rem;font-size:.85rem;cursor:pointer;">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        </form>
                        {% endif %}
                        {% if av.statut != 'refuse' %}
                        <form method="post" action="{{ path('employe_avis_refuser', {id: av.id}) }}" style="display:inline;margin-left:.3rem;">
                            <input type="hidden" name="_token" value="{{ csrf_token('avis_action_' ~ av.id) }}">
                            <button type="submit" title="Refuser"
                                    style="background:#dc3545;border:none;color:#fff;border-radius:8px;padding:.3rem .65rem;font-size:.85rem;cursor:pointer;">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Aucun avis.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── MODAL Annulation employé ────────────────────────────────────────────── #}
<div id="modal-annulation-employe" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1060;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;width:min(520px,95vw);max-height:90vh;overflow-y:auto;padding:2rem;box-shadow:0 20px 60px rgba(0,0,0,.3);">
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4" style="border-bottom:2px solid #E8D1D7;">
            <h5 class="mb-0" style="color:#800020;font-family:'Aclonica',sans-serif;font-size:1.2rem;">
                <i class="bi bi-x-circle me-2"></i>Annuler la commande
            </h5>
            <button type="button" onclick="fermerModalAnnulationEmploye()"
                    style="background:none;border:none;font-size:1.4rem;color:#999;cursor:pointer;">✕</button>
        </div>

        <p id="modal-annulation-employe-titre" style="color:#555;margin-bottom:1.25rem;font-size:.95rem;"></p>

        <form method="post" id="modal-annulation-employe-form">
            <input type="hidden" name="_token" id="modal-annulation-employe-token">

            <div class="mb-3">
                <label class="form-label fw-semibold" style="color:#800020;">Motif d'annulation <span style="color:#999;font-weight:400;">(obligatoire)</span></label>
                <textarea name="motif" id="modal-annulation-employe-motif" rows="3" required
                          class="form-control"
                          style="border-color:#E8D1D7;border-radius:8px;"
                          placeholder="Ex : indisponibilité du personnel, événement exceptionnel, capacité insuffisante…"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold" style="color:#800020;">Mode de contact pour le client</label>
                <div class="d-flex gap-3 mt-1">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;font-size:.9rem;">
                        <input type="radio" name="modeContact" value="email" checked
                               id="modal-contact-email" style="accent-color:#BE7D8D;">
                        <i class="bi bi-envelope-fill" style="color:#BE7D8D;"></i> E-mail
                    </label>
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;font-size:.9rem;" id="modal-contact-gsm-label">
                        <input type="radio" name="modeContact" value="gsm"
                               id="modal-contact-gsm" style="accent-color:#BE7D8D;">
                        <i class="bi bi-telephone-fill" style="color:#BE7D8D;"></i>
                        GSM <span id="modal-gsm-numero" style="color:#999;margin-left:.25rem;"></span>
                    </label>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end pt-2" style="border-top:1px solid #E8D1D7;">
                <button type="button" onclick="fermerModalAnnulationEmploye()"
                        style="border:2px solid #BE7D8D;color:#BE7D8D;background:transparent;border-radius:999px;padding:.5rem 1.5rem;cursor:pointer;font-weight:500;">
                    Retour
                </button>
                <button type="submit"
                        style="border:none;background:#dc3545;color:#fff;border-radius:999px;padding:.5rem 1.5rem;cursor:pointer;font-weight:500;">
                    <i class="bi bi-x-circle-fill me-1"></i> Confirmer l'annulation
                </button>
            </div>
        </form>
    </div>
</div>

{# ── MODAL Modifier Menu ──────────────────────────────────────────────────── #}
<div id="menu-modal" style="display:none;position:fixed;inset:0;z-index:1050;background:rgba(0,0,0,.5);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;width:min(780px,95vw);max-height:90vh;overflow-y:auto;padding:2rem;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.3);">
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4" style="border-bottom:2px solid #E8D1D7;">
            <h5 class="mb-0" style="color:#800020;font-family:'Aclonica',sans-serif;font-size:1.3rem;">Modifier le menu</h5>
            <button type="button" onclick="document.getElementById('menu-modal').style.display='none'"
                    style="background:none;border:none;font-size:1.4rem;color:#800020;cursor:pointer;">✕</button>
        </div>
        <div id="menu-modal-body">
            <div class="text-center py-4 text-muted">Chargement…</div>
        </div>
    </div>
</div>

{# ── MODAL Modifier Plat ──────────────────────────────────────────────────── #}
<div id="plat-modal" style="display:none;position:fixed;inset:0;z-index:1050;background:rgba(0,0,0,.5);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;width:min(680px,95vw);max-height:90vh;overflow-y:auto;padding:2rem;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.3);">
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4" style="border-bottom:2px solid #E8D1D7;">
            <h5 class="mb-0" style="color:#800020;font-family:'Aclonica',sans-serif;font-size:1.3rem;">Modifier le plat</h5>
            <button type="button" onclick="document.getElementById('plat-modal').style.display='none'"
                    style="background:none;border:none;font-size:1.4rem;color:#800020;cursor:pointer;">✕</button>
        </div>
        <div id="plat-modal-body">
            <div class="text-center py-4 text-muted">Chargement…</div>
        </div>
    </div>
</div>

<script>
(function () {
    const tabs = document.querySelectorAll('.account-tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(btn => {
        btn.addEventListener('click', () => {
            tabs.forEach(b => b.classList.remove('active'));
            panels.forEach(p => p.style.display = 'none');
            btn.classList.add('active');
            document.getElementById('tab-' + btn.dataset.tab).style.display = '';
        });
    });

    // Filtres commandes
    const selectStatut = document.getElementById('filter-statut');
    const inputSearch  = document.getElementById('filter-search');

    function filterRows() {
        const statut = selectStatut.value;
        const q = inputSearch.value.toLowerCase();
        document.querySelectorAll('#commandes-table tbody tr[data-statut]').forEach(row => {
            const okStatut = !statut || row.dataset.statut === statut;
            const okSearch = !q || row.dataset.search.includes(q);
            row.style.display = okStatut && okSearch ? '' : 'none';
        });
    }

    selectStatut.addEventListener('change', filterRows);
    inputSearch.addEventListener('input', filterRows);

    // Modal Modifier Plat
    const modal    = document.getElementById('plat-modal');
    const modalBody = document.getElementById('plat-modal-body');

    document.addEventListener('click', e => {
        const btn = e.target.closest('.plat-modifier-btn');
        if (!btn) return;
        modal.style.display = 'flex';
        modalBody.innerHTML = '<div class="text-center py-4 text-muted">Chargement…</div>';
        fetch(btn.dataset.url)
            .then(r => r.text())
            .then(html => { modalBody.innerHTML = html; });
    });

    // Fermer en cliquant sur le fond
    modal.addEventListener('click', e => {
        if (e.target === modal) modal.style.display = 'none';
    });

    // Modal Modifier Menu
    const menuModal     = document.getElementById('menu-modal');
    const menuModalBody = document.getElementById('menu-modal-body');

    document.addEventListener('click', e => {
        const btn = e.target.closest('.menu-modifier-btn');
        if (!btn) return;
        menuModal.style.display = 'flex';
        menuModalBody.innerHTML = '<div class="text-center py-4 text-muted">Chargement…</div>';
        fetch(btn.dataset.url)
            .then(r => r.text())
            .then(html => { menuModalBody.innerHTML = html; });
    });

    menuModal.addEventListener('click', e => {
        if (e.target === menuModal) menuModal.style.display = 'none';
    });

    // Modal Annulation Employé
    document.getElementById('modal-annulation-employe').addEventListener('click', function(e) {
        if (e.target === this) fermerModalAnnulationEmploye();
    });
})();

function ouvrirModalAnnulationEmploye(id, numero, gsm, csrfToken) {
    const modal  = document.getElementById('modal-annulation-employe');
    const titre  = document.getElementById('modal-annulation-employe-titre');
    const form   = document.getElementById('modal-annulation-employe-form');
    const token  = document.getElementById('modal-annulation-employe-token');
    const motif  = document.getElementById('modal-annulation-employe-motif');
    const gsmSpan = document.getElementById('modal-gsm-numero');

    titre.textContent = 'Vous êtes sur le point d\'annuler la commande ' + numero + '.';
    form.action = '/employe/commandes/' + id + '/annuler';
    token.value = csrfToken;
    motif.value = '';
    gsmSpan.textContent = gsm ? '(' + gsm + ')' : '';
    document.getElementById('modal-contact-email').checked = true;
    modal.style.display = 'flex';
}

function fermerModalAnnulationEmploye() {
    document.getElementById('modal-annulation-employe').style.display = 'none';
}
</script>

{% endblock %}
