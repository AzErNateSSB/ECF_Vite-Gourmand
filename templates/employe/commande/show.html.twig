{% extends 'employe/layout.html.twig' %}
{% block title %}Commande #{{ commande.id }}{% endblock %}

{% block employe_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Commande #{{ commande.id }}</h2>
    <a href="{{ path('employe_dashboard') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Détails</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Client</dt>
                    <dd class="col-7">{{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}</dd>
                    <dt class="col-5">Téléphone</dt>
                    <dd class="col-7">{{ commande.utilisateur.telephone }}</dd>
                    <dt class="col-5">Menu</dt>
                    <dd class="col-7"><strong>{{ commande.menu ? commande.menu.titre : '—' }}</strong></dd>
                    <dt class="col-5">Nombre de personnes</dt>
                    <dd class="col-7">{{ commande.nombrePersonne }}</dd>
                    <dt class="col-5">Date de commande</dt>
                    <dd class="col-7">{{ commande.dateCommande|date('d/m/Y à H:i') }}</dd>
                    <dt class="col-5">Total</dt>
                    <dd class="col-7"><strong>{{ commande.prixTotal|number_format(2, ',', ' ') }} €</strong></dd>
                    <dt class="col-5">Statut</dt>
                    <dd class="col-7">
                        <span class="badge
                            {% if commande.statut == 'en_attente' %}bg-warning text-dark
                            {% elseif commande.statut == 'confirmee' %}bg-info
                            {% elseif commande.statut == 'en_preparation' %}bg-primary
                            {% elseif commande.statut == 'prete' %}bg-success
                            {% elseif commande.statut == 'livree' %}bg-secondary
                            {% else %}bg-danger{% endif %}">
                            {{ commande.statut|replace({'_': ' '}) }}
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Changer le statut</div>
            <div class="card-body d-grid gap-2">
                {% set transitions = {
                    'en_attente':     {'label': 'Confirmer',       'statut': 'confirmee',      'class': 'btn-info'},
                    'confirmee':      {'label': 'Démarrer',        'statut': 'en_preparation', 'class': 'btn-primary'},
                    'en_preparation': {'label': 'Marquer prête',   'statut': 'prete',          'class': 'btn-success'},
                    'prete':          {'label': 'Marquer livrée',  'statut': 'livree',         'class': 'btn-secondary'},
                } %}
                {% if commande.statut in transitions|keys %}
                    {% set t = transitions[commande.statut] %}
                    <form method="post" action="{{ path('employe_commande_statut', {id: commande.id}) }}">
                        <input type="hidden" name="statut" value="{{ t.statut }}">
                        <button type="submit" class="btn {{ t.class }} w-100">
                            <i class="bi bi-arrow-right-circle"></i> {{ t.label }}
                        </button>
                    </form>
                {% endif %}
                {% if commande.statut not in ['livree', 'annulee'] %}
                    <form method="post" action="{{ path('employe_commande_statut', {id: commande.id}) }}"
                          onsubmit="return confirm('Annuler cette commande ?')">
                        <input type="hidden" name="statut" value="annulee">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="bi bi-x-circle"></i> Annuler la commande
                        </button>
                    </form>
                {% endif %}
                {% if commande.statut in ['livree', 'annulee'] %}
                    <p class="text-muted text-center mb-0">Commande terminée.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
