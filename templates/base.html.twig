<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Vite & Gourmand{% endblock %} — Traiteur Bordeaux</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Aclonica&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
        <style>
            /* VARIABLES*/
            :root {
                --veg-primary:    #BE7D8D;
                --veg-secondary:  #E8D1D7;
                --veg-dark:       #800020;
                --veg-black:      #540015;
                --veg-font-title: "Aclonica", sans-serif;
                --veg-font-body:  "Calibri", serif;
            }
            /* Legacy aliases (used by older templates) */
            :root {
                --color-primary:   #BE7D8D;
                --color-secondary: #E8D1D7;
                --color-dark:      #800020;
                --color-bg-dark:   #800020;
            }

            /* BASE*/
            html, body { min-height: 100%; }
            body {
                font-family: var(--veg-font-body);
                font-size: 18px;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }
            main, #veg-main { flex: 1; display: flex; flex-direction: column; }
            h1, h2, h3, .font-headline { font-family: var(--veg-font-title); }
            p { font-family: var(--veg-font-body); font-size: 18px; }

            /* LOGO*/
            .logo { height: 75px; width: auto; }

            /* NAVBAR*/
            /* The SPA uses Bootstrap's bg-dark with $dark=#800020 */
            .navbar-veg, .navbar.bg-dark { background-color: var(--veg-dark) !important; }
            .nav-link { font-family: 'Aclonica', sans-serif; }
            .nav-link--signout { color: rgba(190,125,141,.85) !important; }
            .nav-link--signout:hover { color: #BE7D8D !important; }

            /* MENUS FILTRES*/
            .menus-filter-sticky{position:sticky;top:101px;z-index:100;background-color:#E8D1D7;padding:.25rem 0 0}
            .menus-filter{background:#fff;border-radius:14px;box-shadow:0 4px 20px rgba(128,0,32,.08);padding:1rem 1.5rem;display:flex;flex-direction:column;gap:.75rem}
            .menus-filter__row{display:flex;flex-wrap:wrap;align-items:flex-end;gap:1.25rem}
            .menus-filter__row--controls{border-top:1px solid rgba(128,0,32,.08);padding-top:.75rem}
            .menus-filter__sep-v{width:1px;height:36px;background:rgba(128,0,32,.12);align-self:flex-end;flex-shrink:0}
            .menus-filter__group{display:flex;flex-direction:column;gap:.4rem}
            .menus-filter__label{font-family:'Calibri',serif;font-size:.72rem;font-weight:700;letter-spacing:.08em;color:#800020;text-transform:uppercase}
            .menus-filter__tags{display:flex;flex-wrap:wrap;gap:.4rem}
            .menus-filter__counter{display:flex;align-items:center;gap:.5rem;font-family:'Aclonica',sans-serif;font-size:1rem;color:#800020;font-weight:700;min-width:80px}
            .menus-filter__range{width:150px;accent-color:#BE7D8D;cursor:pointer}
            .menus-filter__sort{display:flex;gap:.4rem}
            .menus-filter__date{width:160px;border:1.5px solid rgba(128,0,32,.2);border-radius:8px;padding:.3rem .6rem;font-family:'Calibri',serif;font-size:.85rem;color:#800020;cursor:pointer;accent-color:#BE7D8D;outline:none;transition:border-color .15s}
            .menus-filter__date:focus{border-color:#BE7D8D}
            .menus-filter__reset{margin-left:auto;align-self:flex-end;background:none;border:1.5px solid rgba(128,0,32,.25);border-radius:20px;padding:.3rem .9rem;font-family:'Calibri',serif;font-size:.82rem;color:#800020;cursor:pointer;transition:all .2s;white-space:nowrap}
            .menus-filter__reset:hover{background:#800020;color:#fff;border-color:#800020}
            .menus-filter__count{font-family:'Calibri',serif;font-size:.85rem;color:rgba(128,0,32,.6);margin:.2rem 0 0;min-height:1.1rem}
            .filter-tag{font-family:'Calibri',serif;font-size:.78rem;font-weight:600;padding:.25rem .75rem;border-radius:20px;border:1.5px solid transparent;cursor:pointer;transition:all .15s;background:#f5f5f5;color:#555}
            .filter-tag--veggie.active{background:#e6f4ea;color:#2e7d32;border-color:#2e7d32}
            .filter-tag--gluten.active{background:#fff8e1;color:#f57f17;border-color:#f57f17}
            .filter-tag--lactose.active{background:#e3f2fd;color:#1565c0;border-color:#1565c0}
            .filter-tag--noel.active{background:#fce4ec;color:#c62828;border-color:#c62828}
            .filter-tag--paques.active{background:#f3e5f5;color:#7b1fa2;border-color:#7b1fa2}
            .filter-tag--ete.active{background:#fff9c4;color:#f9a825;border-color:#f9a825}
            .persons-btn{background:none;border:1.5px solid rgba(128,0,32,.3);border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;color:#800020;cursor:pointer;transition:all .15s;flex-shrink:0}
            .persons-btn:hover{background:#800020;color:#fff}
            .sort-btn{background:none;border:1.5px solid rgba(128,0,32,.3);border-radius:8px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:#800020;font-size:1.1rem;cursor:pointer;transition:all .15s}
            .sort-btn:hover,.sort-btn.active{background:#800020;color:#fff;border-color:#800020}

            /* FOOTER*/
            footer.footer, .footer-veg {
                background-color: var(--veg-dark);
                color: #fff;
                padding: 15px;
            }
            footer.footer h4, .footer-veg h4 {
                font-family: var(--veg-font-title);
                font-size: 1rem;
                margin-bottom: .5rem;
            }
            footer.footer a, .footer-veg a {
                color: #E8D1D7;
                text-decoration: none;
            }
            footer.footer a:hover, .footer-veg a:hover { color: #fff; text-decoration: underline; }
            .footer-link { color: #d4a7b3; text-decoration: underline; font-size: .9rem; transition: color .15s; }
            .footer-link:hover { color: #fff; }

            /* BUTTONS*/
            .btn-primary-veg {
                background-color: var(--veg-primary);
                color: #fff; border: none;
                border-radius: 25px; padding: .6rem 1.8rem;
                font-family: var(--veg-font-body);
                transition: background-color .2s;
            }
            .btn-primary-veg:hover { background-color: var(--veg-black); color: #fff; }
            .btn-outline-veg {
                border: 2px solid var(--veg-primary); color: var(--veg-primary);
                border-radius: 25px; padding: .45rem 1.4rem; background: transparent;
                font-family: var(--veg-font-body);
            }
            .btn-outline-veg:hover { background-color: var(--veg-primary); color: #fff; }
            .link-veg { color: var(--veg-primary); text-decoration: underline; }
            .link-veg:hover { color: var(--veg-dark); }

            /* HERO*/
            .hero {
                position: relative; min-height: 480px;
                background-size: cover; background-position: center; background-repeat: no-repeat;
                display: flex; align-items: center;
            }
            .hero .hero-overlay {
                position: absolute; inset: 0;
                background: linear-gradient(to right, rgba(0,0,0,.97) 0%, rgba(0,0,0,.60) 60%, rgba(0,0,0,.30) 100%);
            }
            .hero .container { position: relative; z-index: 1; }
            .hero .hero-content { padding: 3rem 0; }
            @media (max-width: 575.98px) { .hero .hero-content { text-align: center; } }
            .hero .hero-label { font-family: var(--veg-font-body); font-size: .8rem; letter-spacing: .15em; color: var(--veg-primary); margin-bottom: 1rem; }
            .hero .hero-title { font-family: var(--veg-font-title); font-size: clamp(2rem,4vw,3.2rem); font-weight: 700; color: #fff; line-height: 1.15; margin-bottom: 1.25rem; }
            .hero .hero-accent { color: var(--veg-primary); font-style: italic; }
            .hero .hero-desc { font-family: var(--veg-font-body); font-size: 1rem; color: #e0d0d4; line-height: 1.7; margin-bottom: 2rem; }
            .hero .hero-btn { background-color: var(--veg-dark); color: var(--veg-secondary); font-family: var(--veg-font-body); font-weight: 600; border-radius: 25px; padding: .6rem 1.8rem; border: none; transition: background-color .2s; }
            .hero .hero-btn:hover { background-color: var(--veg-black); color: var(--veg-secondary); }
            .hero .hero-mention { font-family: var(--veg-font-body); font-size: .85rem; color: var(--veg-secondary); opacity: .85; }
            .hero--right .hero-overlay--right { background: linear-gradient(to left, rgba(0,0,0,.97) 0%, rgba(0,0,0,.60) 60%, rgba(0,0,0,.30) 100%); }
            .hero--right .hero-content { margin-left: auto; text-align: right; }
            @media (max-width: 575.98px) { .hero--right .hero-content { margin-left: 0; text-align: center; } }

            /* HERO SEPARATOR*/
            .hero-separator {
                background-color: var(--veg-dark);
                display: flex; align-items: center; justify-content: center; gap: 1rem; padding: .9rem 2rem;
            }
            .hero-separator span { flex: 1; height: 1px; background: linear-gradient(to right, transparent, rgba(232,209,215,.5)); }
            .hero-separator span:last-child { background: linear-gradient(to left, transparent, rgba(232,209,215,.5)); }
            .hero-separator i { font-size: 1.2rem; color: var(--veg-secondary); opacity: .8; }

            /* AVIS*/
            .avis-section { background-color: var(--veg-secondary); padding: 4rem 0 5rem; }
            .avis-section__title { font-family: var(--veg-font-title); font-size: clamp(1.6rem,3vw,2.2rem); color: var(--veg-dark); margin-bottom: 0; }
            .avis-section__controls { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 2rem; }
            .avis-card { background: #fff; border-radius: 12px; padding: 2rem 1.75rem; max-width: 680px; box-shadow: 0 4px 20px rgba(128,0,32,.08); display: flex; flex-direction: column; gap: 1rem; }
            .avis-card__stars { color: var(--veg-primary); font-size: 1.4rem; letter-spacing: .12em; text-align: center; text-shadow: 0 2px 6px rgba(190,125,141,.45); }
            .avis-card__quote { font-family: var(--veg-font-body); font-size: .95rem; color: #444; line-height: 1.7; flex: 1; margin: 0; font-style: italic; }
            .avis-card__author { display: flex; flex-direction: column; font-family: var(--veg-font-body); font-size: .85rem; }
            .avis-card__author strong { color: var(--veg-dark); font-size: .95rem; }
            .avis-card__author span { color: #888; }
            .avis-carousel-wrapper { overflow: hidden; }
            .avis-carousel-wrapper .carousel-inner { min-height: 260px; }
            .avis-carousel-wrapper .carousel-item { padding: 0 1.5rem; }
            .avis-cta { background-color: var(--veg-dark); color: #fff; border-radius: 25px; padding: .7rem 2.2rem; font-family: var(--veg-font-body); font-weight: 600; border: none; transition: background-color .2s; }
            .avis-cta:hover { background-color: var(--veg-black); color: #fff; }
            .avis-btn { background: none; border: 2px solid var(--veg-dark); border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; color: var(--veg-dark); font-size: 1rem; transition: background-color .2s, color .2s; flex-shrink: 0; }
            .avis-btn:hover { background-color: var(--veg-dark); color: #fff; }
            .avis-indicators { position: static !important; margin: 0 !important; gap: 6px; }
            .avis-indicators button { width: 8px !important; height: 8px !important; border-radius: 50% !important; background-color: var(--veg-dark) !important; opacity: .3 !important; border: none !important; flex-shrink: 0; }
            .avis-indicators button.active { opacity: 1 !important; }

            /* AUTH PAGES (login / signup)*/
            .auth-page { min-height: calc(100vh - 200px); display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; background: var(--veg-secondary); }
            .auth-card { background: #fff; border-radius: 16px; box-shadow: 0 8px 40px rgba(128,0,32,.12); padding: 2.5rem 2rem; width: 100%; max-width: 440px; margin-left: auto; margin-right: auto; }
            .auth-card--wide { max-width: 600px; }
            .auth-card__header { text-align: center; margin-bottom: 1.75rem; }
            .auth-card__title { font-family: var(--veg-font-title); font-style: italic; font-size: 2rem; color: var(--veg-dark); margin: 0 0 .25rem; }
            .auth-card__subtitle { font-family: var(--veg-font-body); font-size: .9rem; color: rgba(128,0,32,.55); margin: 0; }
            .auth-card__forgot { text-align: right; margin: -.25rem 0 1rem; }
            .auth-card__forgot a { font-family: var(--veg-font-body); font-size: .82rem; color: var(--veg-primary); text-decoration: none; }
            .auth-card__forgot a:hover { text-decoration: underline; }
            .auth-card__forgot-title { font-family: var(--veg-font-body); font-size: .9rem; color: var(--veg-dark); margin-bottom: .75rem; }
            .auth-card__forgot-title i { color: var(--veg-primary); margin-right: .35rem; }
            .auth-card__switch { text-align: center; font-family: var(--veg-font-body); font-size: .875rem; color: rgba(128,0,32,.65); margin: 0; }
            .auth-card__switch a { color: var(--veg-primary); font-weight: 600; text-decoration: none; }
            .auth-card__switch a:hover { text-decoration: underline; }
            .auth-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
            .auth-field { display: flex; flex-direction: column; margin-bottom: 1.1rem; }
            .auth-field__label { font-family: var(--veg-font-body); font-size: .85rem; font-weight: 600; color: var(--veg-dark); margin-bottom: .35rem; }
            .auth-field__input-wrap { position: relative; display: flex; align-items: center; }
            .auth-field__input { width: 100%; padding: .6rem .85rem; border: 1.5px solid rgba(128,0,32,.18); border-radius: 8px; font-family: var(--veg-font-body); font-size: .9rem; color: var(--veg-dark); transition: border-color .15s; outline: none; }
            .auth-field__input:focus { border-color: var(--veg-primary); box-shadow: 0 0 0 3px rgba(190,125,141,.12); }
            .auth-field__input-wrap .auth-field__input { padding-right: 2.5rem; }
            .auth-field__eye { position: absolute; right: .65rem; background: none; border: none; color: rgba(128,0,32,.4); cursor: pointer; padding: 0; font-size: 1rem; }
            .auth-field__eye:hover { color: var(--veg-primary); }
            .auth-field__error { font-family: var(--veg-font-body); font-size: .78rem; color: #c62828; margin-top: .3rem; min-height: 1rem; }
            .auth-alert { border-radius: 8px; padding: .7rem 1rem; font-family: var(--veg-font-body); font-size: .875rem; margin-bottom: 1.1rem; }
            .auth-alert--error { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }
            .auth-alert--success { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
            .auth-btn { width: 100%; padding: .75rem; background: var(--veg-primary); color: #fff; border: none; border-radius: 25px; font-family: var(--veg-font-body); font-size: .95rem; font-weight: 600; cursor: pointer; transition: background-color .2s; display: flex; align-items: center; justify-content: center; gap: .5rem; margin-top: .5rem; }
            .auth-btn:hover { background: var(--veg-dark); }
            .auth-btn--secondary { background: transparent; color: var(--veg-primary); border: 2px solid var(--veg-primary); margin-top: .5rem; }
            .auth-btn--secondary:hover { background: var(--veg-primary); color: #fff; }
            .auth-sep { border-color: rgba(128,0,32,.1); margin: 1.25rem 0; }
            .auth-password-strength { margin-top: .5rem; display: flex; align-items: center; gap: .75rem; }
            .auth-password-strength__bar { flex: 1; height: 5px; background: rgba(128,0,32,.1); border-radius: 3px; overflow: hidden; }
            .auth-password-strength__bar span { display: block; height: 100%; width: 0; border-radius: 3px; transition: width .3s, background-color .3s; }
            .auth-password-strength__bar span.weak { background: #c62828; }
            .auth-password-strength__bar span.medium { background: #e65100; }
            .auth-password-strength__bar span.strong { background: #2e7d32; }
            .auth-password-strength__label { font-family: var(--veg-font-body); font-size: .75rem; color: rgba(128,0,32,.55); white-space: nowrap; }
            .auth-password-rules { list-style: none; padding: .5rem 0 0; margin: 0; display: flex; flex-direction: column; gap: .2rem; }
            .auth-password-rules li { font-family: var(--veg-font-body); font-size: .78rem; color: rgba(128,0,32,.5); display: flex; align-items: center; gap: .4rem; }
            .auth-password-rules li i { color: #c62828; font-size: .8rem; }
            .auth-password-rules li.ok { color: #2e7d32; }
            .auth-password-rules li.ok i { color: #2e7d32; }

            /* CONTACT PAGE*/
            .contact-page { background: var(--veg-secondary); min-height: 100%; }
            .contact-page__intro { color: rgba(128,0,32,.65); font-size: .95rem; margin-bottom: 1.75rem; line-height: 1.6; }
            .contact-textarea { resize: vertical; min-height: 140px; font-family: var(--veg-font-body); }
            .contact-char-count { display: block; text-align: right; font-size: .78rem; color: rgba(128,0,32,.4); margin-top: .25rem; }
            .contact-success { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 1.5rem 1rem; gap: 1rem; }
            .contact-success__icon { font-size: 3.5rem; color: #a0536a; line-height: 1; }
            .contact-success__title { font-family: var(--veg-font-title); color: var(--veg-dark); font-size: 1.5rem; margin: 0; }
            .contact-success__text { color: rgba(128,0,32,.7); max-width: 400px; line-height: 1.6; text-align: center; margin: 0 auto; }
            .contact-info { display: grid; grid-template-columns: repeat(2,1fr); gap: 1rem; max-width: 680px; margin: 1.75rem auto 0; }
            .contact-info__item { background: #fff; border-radius: 12px; padding: 1rem 1.25rem; display: flex; align-items: flex-start; gap: .85rem; box-shadow: 0 2px 10px rgba(128,0,32,.07); }
            .contact-info__item i { font-size: 1.3rem; color: var(--veg-primary); flex-shrink: 0; margin-top: .1rem; }
            .contact-info__item div { display: flex; flex-direction: column; gap: .15rem; }
            .contact-info__item strong { font-size: .85rem; color: var(--veg-dark); }
            .contact-info__item span { font-size: .82rem; color: rgba(128,0,32,.6); }

            /* MENTIONS LÉGALES*/
            .mentions-page { background: var(--veg-secondary); flex: 1; }
            .mentions-card { background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(128,0,32,.08); padding: 2.5rem 3rem; max-width: 800px; margin: 0 auto; }
            .mentions-card__title { font-family: var(--veg-font-title); font-size: 1.8rem; color: var(--veg-dark); margin-bottom: .25rem; }
            .mentions-card__update { font-size: .82rem; color: rgba(128,0,32,.4); margin-bottom: 2rem; font-style: italic; }
            .mentions-section { margin-bottom: 1.75rem; padding-bottom: 1.75rem; border-bottom: 1px solid rgba(232,209,215,.8); }
            .mentions-section:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
            .mentions-section__title { font-family: var(--veg-font-title); font-size: 1rem; color: var(--veg-dark); margin-bottom: .75rem; }
            .mentions-section p, .mentions-section li { font-size: .9rem; color: rgba(128,0,32,.7); line-height: 1.7; }
            .mentions-section a { color: var(--veg-primary); }
            .mentions-section a:hover { color: var(--veg-dark); }
            .mentions-list { padding-left: 1.25rem; margin: .5rem 0 1rem; }
            .mentions-list li { margin-bottom: .35rem; }

            /* MON COMPTE (account)*/
            .account-page { background: var(--veg-secondary); min-height: 100%; }
            .account-header { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2rem; max-width: 720px; margin-left: auto; margin-right: auto; }
            .account-header__avatar { width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--veg-dark); color: #fff; display: flex; align-items: center; justify-content: center; font-family: var(--veg-font-title); font-size: 1.3rem; flex-shrink: 0; }
            .account-header__name { font-family: var(--veg-font-title); font-size: 1.5rem; color: var(--veg-dark); margin: 0; }
            .account-header__email { font-size: .88rem; color: rgba(128,0,32,.55); margin: 0; }
            .account-tabs { display: flex; gap: .5rem; margin-bottom: 1.5rem; flex-wrap: wrap; max-width: 720px; margin-left: auto; margin-right: auto; }
            .account-tabs__btn { background: rgba(255,255,255,.6); border: 2px solid transparent; border-radius: 25px; padding: .5rem 1.25rem; font-family: var(--veg-font-body); font-size: .9rem; color: rgba(128,0,32,.6); cursor: pointer; transition: all .2s; }
            .account-tabs__btn i { margin-right: .35rem; }
            .account-tabs__btn:hover { background: #fff; color: var(--veg-dark); }
            .account-tabs__btn.active { background: var(--veg-dark); color: #fff; border-color: var(--veg-dark); }
            .account-card { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(128,0,32,.08); padding: 2rem; max-width: 720px; margin: 0 auto; }
            .account-card__title { font-family: var(--veg-font-title); color: var(--veg-dark); font-size: 1.2rem; margin-bottom: 1.5rem; }
            .account-card__subtitle { color: rgba(128,0,32,.55); font-size: .9rem; margin-top: -1rem; margin-bottom: 1.5rem; }
            .account-card__actions { display: flex; justify-content: flex-end; margin-top: 1.5rem; }
            .account-empty { color: rgba(128,0,32,.45); font-style: italic; text-align: center; padding: 1.5rem 0; }
            .account-panel { display: none; }
            .account-panel.active { display: block; }

            /* COMMANDE ITEMS*/
            .commande-item { border: 1px solid rgba(190,125,141,.2); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
            .commande-item:last-child { margin-bottom: 0; }
            .commande-item__head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: .6rem; gap: .5rem; }
            .commande-item__id { font-size: .78rem; font-weight: 700; color: var(--veg-dark); display: block; }
            .commande-item__date { font-size: .8rem; color: rgba(128,0,32,.5); display: block; }
            .commande-item__statut { font-size: .75rem; font-weight: 700; padding: .25rem .75rem; border-radius: 25px; white-space: nowrap; }
            .commande-item__statut--en-attente { background: #fff3cd; color: #856404; }
            .commande-item__statut--confirmee { background: #d1e7dd; color: #0a3622; }
            .commande-item__statut--en-preparation { background: #cfe2ff; color: #084298; }
            .commande-item__statut--prete { background: #d1e7dd; color: #0a3622; }
            .commande-item__statut--livree { background: #f3e6e9; color: #800020; }
            .commande-item__statut--annulee { background: #f8d7da; color: #842029; }
            .commande-item__body { display: flex; justify-content: space-between; align-items: center; font-size: .9rem; color: rgba(128,0,32,.7); }
            .commande-item__body i { margin-right: .35rem; color: var(--veg-primary); }
            .commande-item__body strong { color: var(--veg-dark); }

            /* AVIS STARS*/
            .avis-stars-input { display: flex; gap: .3rem; margin-top: .4rem; }
            .avis-star { background: none; border: none; font-size: 1.6rem; color: rgba(128,0,32,.25); cursor: pointer; padding: 0; line-height: 1; transition: color .1s; }
            .avis-star.active, .avis-star:hover { color: var(--veg-primary); }

            /* 404*/
            .not-found-page { background: var(--veg-secondary); flex: 1; display: flex; align-items: center; justify-content: center; padding: 3rem 1rem; }
            .not-found-card { background: #fff; border-radius: 1rem; padding: 3rem 2.5rem; text-align: center; max-width: 480px; width: 100%; box-shadow: 0 4px 24px rgba(128,0,32,.10); }
            .not-found-code { font-size: 6rem; font-weight: 700; line-height: 1; color: var(--veg-primary); font-family: var(--veg-font-title); letter-spacing: -4px; margin-bottom: .5rem; }
            .not-found-title { font-size: 1.5rem; color: var(--veg-dark); margin-bottom: .75rem; }
            .not-found-text { color: rgba(128,0,32,.65); font-size: .95rem; margin-bottom: 2rem; }
            .not-found-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

            /* MENU CARDS (public)*/
            .menus-page { background-color: var(--veg-secondary); min-height: 100vh; }
            .menus-page__header { padding: 3.5rem 1rem .5rem; }
            .menus-page__title { font-family: var(--veg-font-title); font-size: clamp(2.4rem,5vw,3.5rem); color: var(--veg-dark); margin-bottom: .5rem; }
            .menus-page__divider { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-bottom: .75rem; }
            .menus-page__divider span { width: 80px; height: 1px; background: rgba(128,0,32,.4); }
            .menus-page__divider i { font-size: 1rem; color: var(--veg-primary); }
            .menu-card { background: #fff; border-radius: 14px; box-shadow: 0 4px 24px rgba(128,0,32,.1); overflow: hidden; display: flex; flex-direction: column; height: 100%; }
            .menu-card__img-wrapper { height: 200px; overflow: hidden; position: relative; background: #e8c4cc; }
            .menu-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
            .menu-card:hover .menu-card__img { transform: scale(1.04); }
            .menu-card__body { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; }
            .menu-card__title-row { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; margin-bottom: .5rem; }
            .menu-card__name { font-family: var(--veg-font-title); font-style: italic; font-size: 1.4rem; color: var(--veg-dark); margin: 0; }
            .menu-card__desc { font-family: var(--veg-font-body); font-size: .9rem; color: #555; margin-bottom: .75rem; line-height: 1.5; }
            .menu-card__tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .5rem; }
            .menu-card__sep { border-color: rgba(128,0,32,.12); margin: .75rem 0; }
            .menu-card__courses { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-direction: column; gap: .75rem; flex: 1; }
            .menu-card__courses li { display: flex; align-items: flex-start; gap: .65rem; font-family: var(--veg-font-body); font-size: .88rem; color: #444; line-height: 1.45; }
            .menu-card__courses li i { color: var(--veg-primary); font-size: 1rem; margin-top: .15rem; flex-shrink: 0; }
            .menu-card__courses li strong { color: var(--veg-dark); font-size: .9rem; }
            .menu-card__footer { border-top: 1px solid rgba(128,0,32,.1); padding-top: 1rem; display: flex; flex-direction: column; gap: .75rem; }
            .menu-card__price { font-family: var(--veg-font-title); font-size: 1.6rem; color: var(--veg-dark); margin: 0; }
            .menu-card__price span { font-family: var(--veg-font-body); font-size: .85rem; color: #888; font-weight: normal; }
            .menu-card__btn { background-color: var(--veg-primary); color: #fff; border-radius: 25px; padding: .6rem 1.5rem; font-family: var(--veg-font-body); font-weight: 600; border: none; text-align: center; transition: background-color .2s; text-decoration: none; display: block; }
            .menu-card__btn:hover { background-color: var(--veg-dark); color: #fff; }
            .menu-card__stock { font-family: var(--veg-font-body); font-size: .8rem; font-weight: 600; display: flex; align-items: center; gap: .35rem; margin: 0; }
            .menu-card__stock--ok { color: #2e7d32; }
            .menu-card__stock--low { color: #e65100; }
            .menu-card__stock--critical { color: #c62828; }
            .menu-tag { font-family: var(--veg-font-body); font-size: .75rem; padding: .2rem .65rem; border-radius: 20px; font-weight: 600; }
            .menu-tag--veggie { background: #e6f4ea; color: #2e7d32; }
            .menu-tag--gluten { background: #fff8e1; color: #f57f17; }
            .menu-tag--lactose { background: #e3f2fd; color: #1565c0; }
            .menu-tag--noel { background: #fce4ec; color: #c62828; }
            .menu-tag--paques { background: #f3e5f5; color: #7b1fa2; }
            .menu-tag--ete { background: #fff9c4; color: #f9a825; }

            /* CAROUSEL ARROWS COLOR*/
            .carousel-control-prev-icon,
            .carousel-control-next-icon {
                filter: invert(12%) sepia(92%) saturate(2500%) hue-rotate(330deg);
            }
            .carousel-control-prev, .carousel-control-next { width: auto; }

            /* MISC*/
            .bg-secondary-veg { background-color: var(--veg-secondary); }
            .bg-dark-veg { background-color: var(--veg-dark); }
            .section-title { font-family: var(--veg-font-title); color: var(--veg-dark); margin-bottom: 1.5rem; }
        </style>
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block scripts %}{% endblock %}
    </body>
</html>
